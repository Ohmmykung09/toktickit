generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model User {
  id                         Int             @id @default(autoincrement())
  name                       String
  email                      String          @unique
  passwordHash               String?
  passwordProvisionedAt      DateTime?
  role                       UserRole        @default(REQUESTER)
  isActive                   Boolean         @default(true)
  mustChangePassword         Boolean         @default(true)
  failedLoginAttempts        Int             @default(0)
  failedLoginWindowStartedAt DateTime?
  lockedUntil                DateTime?
  sessionVersion             Int             @default(1)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  requestedTickets           Ticket[]        @relation("TicketRequester")
  ownedTickets               Ticket[]        @relation("TicketOwner")
  resolutionIndications      Ticket[]        @relation("TicketResolutionIndicatedBy")
  assignedActions            ActionTaken[]   @relation("ActionTakenAssignee")
  createdActions             ActionTaken[]   @relation("ActionTakenCreator")
  performedActions           ActionTaken[]   @relation("ActionTakenPerformer")
  removedAttachments         Attachment[]    @relation("AttachmentRemovedBy")
  sessions                   Session[]
  publicComments             PublicComment[]
  internalNotes              InternalNote[]

  @@index([isActive, role, name])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]

  @@index([isActive, name])
}

model Ticket {
  id                               Int               @id @default(autoincrement())
  ticketNumber                     String            @unique
  idempotencyKey                   String
  requesterId                      Int
  ownerId                          Int?
  categoryId                       Int
  relatedSystemId                  Int
  summary                          String
  requestedPriority                RequestedPriority
  itPriority                       RequestedPriority
  description                      String
  status                           TicketStatus      @default(NEW)
  resolutionCycle                  Int               @default(1)
  resolvedAt                       DateTime?
  requesterResolutionIndicatedAt   DateTime?
  requesterResolutionIndicatedById Int?
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt
  requester                        User              @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner                            User?             @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  requesterResolutionIndicatedBy   User?             @relation("TicketResolutionIndicatedBy", fields: [requesterResolutionIndicatedById], references: [id], onDelete: SetNull)
  category                         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem                    RelatedSystem     @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments                      Attachment[]
  actionsTaken                     ActionTaken[]
  publicComments                   PublicComment[]
  internalNotes                    InternalNote[]

  @@unique([requesterId, idempotencyKey])
  @@index([requesterId, updatedAt])
  @@index([ownerId, status, updatedAt])
  @@index([status, itPriority, updatedAt])
}

model ActionTaken {
  id               Int               @id @default(autoincrement())
  ticketId         Int
  actionDateTime   DateTime
  description      String
  result           String
  status           ActionTakenStatus @default(OPEN)
  resolutionCycle  Int               @default(1)
  assigneeId       Int?
  createdById      Int
  performedById    Int
  followUpRequired Boolean           @default(false)
  followUpNote     String?
  attachmentNotes  String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  version          Int               @default(1)
  fixtureKey       String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ticket           Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee         User?             @relation("ActionTakenAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy        User              @relation("ActionTakenCreator", fields: [createdById], references: [id], onDelete: Restrict)
  performedBy      User              @relation("ActionTakenPerformer", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([ticketId, actionDateTime, id])
  @@index([ticketId, resolutionCycle, status, completedAt])
  @@index([assigneeId, status, updatedAt])
  @@index([performedById, actionDateTime])
}

model Session {
  id             Int       @id @default(autoincrement())
  userId         Int
  sessionVersion Int
  tokenHash      String    @unique
  csrfTokenHash  String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFileName String
  storedFileName   String    @unique
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime  @default(now())
  removedAt        DateTime?
  removalReason    String?
  removedByUserId  Int?
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  removedByUser    User?     @relation("AttachmentRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, removedAt])
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ActionTakenStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  COMPLETED
  CANCELLED
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}
