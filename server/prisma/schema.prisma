generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model DevelopmentRequester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
  removedAttachments Attachment[] @relation("AttachmentRemovedBy")

  @@index([isActive, name])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]

  @@index([isActive, name])
}

model Ticket {
  id                     Int                    @id @default(autoincrement())
  ticketNumber           String                 @unique
  idempotencyKey         String
  requesterId            Int
  categoryId             Int
  relatedSystemId        Int
  summary                String
  requestedPriority      RequestedPriority
  description            String
  status                 TicketStatus           @default(NEW)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  requester              DevelopmentRequester  @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  category               Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem          RelatedSystem          @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments            Attachment[]

  @@index([requesterId, updatedAt])
  @@unique([requesterId, idempotencyKey])
}

model Attachment {
  id                     Int                    @id @default(autoincrement())
  ticketId               Int
  originalFileName       String
  storedFileName         String                 @unique
  mimeType               String
  sizeBytes              Int
  createdAt              DateTime               @default(now())
  removedAt              DateTime?
  removalReason          String?
  removedByRequesterId   Int?
  ticket                 Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  removedByRequester     DevelopmentRequester? @relation("AttachmentRemovedBy", fields: [removedByRequesterId], references: [id], onDelete: SetNull)

  @@index([ticketId, removedAt])
}

enum TicketStatus {
  NEW
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
