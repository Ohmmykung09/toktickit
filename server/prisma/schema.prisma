generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model User {
  id                         Int          @id @default(autoincrement())
  name                       String
  email                      String       @unique
  passwordHash               String
  role                       UserRole     @default(REQUESTER)
  isActive                   Boolean      @default(true)
  mustChangePassword         Boolean      @default(true)
  failedLoginAttempts        Int          @default(0)
  failedLoginWindowStartedAt DateTime?
  lockedUntil                DateTime?
  sessionVersion             Int          @default(1)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  requestedTickets           Ticket[]     @relation("TicketRequester")
  removedAttachments         Attachment[] @relation("AttachmentRemovedBy")

  @@index([isActive, role, name])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]

  @@index([isActive, name])
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  idempotencyKey    String
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  summary           String
  requestedPriority RequestedPriority
  description       String
  status            TicketStatus      @default(NEW)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  requester         User              @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem     RelatedSystem     @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments       Attachment[]

  @@unique([requesterId, idempotencyKey])
  @@index([requesterId, updatedAt])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFileName String
  storedFileName   String    @unique
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime  @default(now())
  removedAt        DateTime?
  removalReason    String?
  removedByUserId  Int?
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  removedByUser    User?     @relation("AttachmentRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, removedAt])
}

enum TicketStatus {
  NEW
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}
